# GitHub — PAT with repo + pull_request write scope for your org
GITHUB_TOKEN=ghp_...
GITHUB_ORG=CasewareProduct

# Coolify — generate in Coolify → Settings → Keys & Tokens
# Token needs read permission (to list team members + projects)
# and write permission (to create projects + applications)
COOLIFY_URL=http://coolify:8080
COOLIFY_TOKEN=...

# Anthropic — for stack detection
ANTHROPIC_API_KEY=sk-ant-...

# Portal config
BASE_DEPLOY_DOMAIN=caseware.steadypat.ch
PORT=4000

# Admin — comma-separated emails that get full control over all projects
ADMIN_EMAILS=mike.shoss@company.com
